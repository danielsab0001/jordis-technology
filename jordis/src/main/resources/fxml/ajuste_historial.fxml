<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.AjusteHistorialController"
      spacing="14" style="-fx-background-color: white; -fx-padding: 24;">

    <Text text="Historial de Ajustes"
          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>

    <VBox spacing="4"
          style="-fx-background-color: #EFF6FF; -fx-padding: 10 14;
                 -fx-border-radius: 6; -fx-background-radius: 6;">
        <Label fx:id="lblProducto"
               style="-fx-font-size: 13; -fx-font-weight: bold;
                      -fx-text-fill: #1E40AF;"/>
        <Label fx:id="lblStockActual"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
    </VBox>

    <TableView fx:id="tablaAjustes" prefHeight="320"
               style="-fx-border-color: #DBEAFE; -fx-border-radius: 6;
                      -fx-font-size: 12;">
        <columns>
            <TableColumn fx:id="colFecha"    text="Fecha"       prefWidth="130"/>
            <TableColumn fx:id="colUsuario"  text="Realizado por" prefWidth="140"/>
            <TableColumn fx:id="colTipo"     text="Tipo"        prefWidth="90"/>
            <TableColumn fx:id="colCantidad" text="Cantidad"    prefWidth="80"/>
            <TableColumn fx:id="colMotivo"   text="Motivo"      prefWidth="280"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Cerrar" onAction="#onCerrar"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 13;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>