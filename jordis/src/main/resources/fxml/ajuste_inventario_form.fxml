<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.AjusteInventarioController"
      spacing="14" style="-fx-background-color: white; -fx-padding: 24;">

    <Text text="Ajuste de Inventario"
          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>

    <!-- Producto seleccionado -->
    <VBox spacing="4"
          style="-fx-background-color: #EFF6FF; -fx-padding: 10 14;
                 -fx-border-radius: 6; -fx-background-radius: 6;">
        <Label fx:id="lblProducto"
               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1E40AF;"/>
        <Label fx:id="lblStockActual"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
    </VBox>

    <!-- Tipo de operación -->
    <VBox spacing="6">
        <Label text="Tipo de operación:"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <HBox spacing="12">
            <fx:define>
                <ToggleGroup fx:id="grupoOperacion"/>
            </fx:define>
            <RadioButton fx:id="rbEntrada" text="📥  Entrada (aumentar stock)"
                         toggleGroup="$grupoOperacion" selected="true"
                         style="-fx-font-size: 13;"/>
            <RadioButton fx:id="rbSalida" text="📤  Salida (reducir stock)"
                         toggleGroup="$grupoOperacion"
                         style="-fx-font-size: 13; -fx-text-fill: #DC2626;"/>
        </HBox>
    </VBox>

    <!-- Cantidad -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Cantidad a ajustar:"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtCantidad" promptText="Ej: 10"
                       prefWidth="120" prefHeight="36"
                       style="-fx-font-size: 14; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Stock resultante:"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <Label fx:id="lblStockResultante" text="—"
                   style="-fx-font-size: 18; -fx-font-weight: bold;
                          -fx-text-fill: #2563EB;"/>
        </VBox>
    </HBox>

    <!-- Motivo -->
    <VBox spacing="6">
        <Label text="Motivo del ajuste:"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <ComboBox fx:id="cmbMotivo" prefWidth="420" prefHeight="36"
                  style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                         -fx-border-radius: 6; -fx-background-radius: 6;"/>
    </VBox>

    <!-- Otra razón — solo visible si selecciona "Otra razón" -->
    <VBox fx:id="panelOtraRazon" spacing="4" visible="false" managed="false">
        <Label text="Especifica la razón:"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextArea fx:id="txtOtraRazon"
                  promptText="Describe el motivo del ajuste..."
                  prefHeight="70" wrapText="true"
                  style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                         -fx-border-radius: 6; -fx-background-radius: 6;
                         -fx-padding: 4 10;"/>
    </VBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #DC2626; -fx-font-size: 12;"/>

    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Aplicar ajuste" onAction="#onGuardar"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-background-radius: 6;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: transparent; -fx-text-fill: #2563EB;
                       -fx-border-color: #2563EB; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 13;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>