<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.AuditoriaController"
      spacing="0" style="-fx-background-color: #F8FAFF;">

    <HBox style="-fx-background-color: white; -fx-padding: 16 24;
                 -fx-border-color: #DBEAFE; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="12">
        <Text text="Auditoría"
              style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="↻  Actualizar" onAction="#onActualizar"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 7 14; -fx-cursor: hand;"/>
    </HBox>

    <HBox style="-fx-padding: 12 24;" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar"
                   promptText="Buscar por usuario, acción o detalle..."
                   prefWidth="320" prefHeight="34"
                   style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                      -fx-border-radius: 6; -fx-background-radius: 6;
                      -fx-padding: 4 10;"/>
        <ComboBox fx:id="cmbAccion" promptText="Todas las acciones"
                  prefWidth="220" prefHeight="34"
                  style="-fx-font-size: 12;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 0 24 16 24;">
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS"
                   style="-fx-border-color: #DBEAFE; -fx-border-radius: 8;
                          -fx-font-size: 12;">
            <columns>
                <TableColumn fx:id="colFecha"   text="Fecha y hora" prefWidth="150"/>
                <TableColumn fx:id="colUsuario" text="Usuario"      prefWidth="160"/>
                <TableColumn fx:id="colAccion"  text="Acción"       prefWidth="170"/>
                <TableColumn fx:id="colEntidad" text="Sobre"        prefWidth="110"/>
                <TableColumn fx:id="colDetalle" text="Detalle"      prefWidth="680"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="lblMensaje" text=""
           style="-fx-padding: 0 24 10 24; -fx-font-size: 12;"/>
</VBox>