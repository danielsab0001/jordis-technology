<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.CategoriaController"
      spacing="0" style="-fx-background-color: #F8FAFF;">

    <HBox style="-fx-background-color: white; -fx-padding: 16 24;
                 -fx-border-color: #DBEAFE; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="12">
        <Text text="Categorías de Productos"
              style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Nueva categoría" onAction="#onNuevaCategoria"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-background-radius: 6;
                       -fx-padding: 7 14; -fx-cursor: hand;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 16 24;">
        <TableView fx:id="tablaCategorias" VBox.vgrow="ALWAYS"
                   style="-fx-border-color: #DBEAFE; -fx-border-radius: 8;
                          -fx-font-size: 12;">
            <columns>
                <TableColumn fx:id="colId"          text="ID"          prefWidth="60"/>
                <TableColumn fx:id="colNombre"      text="Nombre"      prefWidth="200"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
                <TableColumn fx:id="colProductos"   text="Productos"   prefWidth="90"/>
                <TableColumn fx:id="colAcciones"    text="Acciones"    prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="lblMensaje" text=""
           style="-fx-padding: 0 24 10 24; -fx-font-size: 12;"/>
</VBox>