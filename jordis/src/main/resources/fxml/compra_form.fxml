<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.CompraFormController"
      spacing="12" style="-fx-background-color: white; -fx-padding: 24;">

    <Text text="Nueva Compra"
          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>

    <!-- Proveedor -->
    <VBox spacing="4">
        <Label text="Proveedor *" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <ComboBox fx:id="cmbProveedor" prefWidth="340" prefHeight="34"
                  style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                         -fx-border-radius: 6; -fx-background-radius: 6;"/>
    </VBox>

    <!-- Descripción opcional -->
    <VBox spacing="4">
        <Label text="Descripción (opcional)"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextArea fx:id="txtDescripcion"
                  promptText="Notas adicionales sobre esta compra..."
                  prefHeight="60" wrapText="true"
                  style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                         -fx-border-radius: 6; -fx-background-radius: 6;
                         -fx-padding: 4 10;"/>
    </VBox>

    <!-- Agregar producto -->
    <HBox spacing="10" alignment="BOTTOM_LEFT">
        <VBox spacing="4">
            <Label text="Producto" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <ComboBox fx:id="cmbProducto" prefWidth="230" prefHeight="34"
                      style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                             -fx-border-radius: 6; -fx-background-radius: 6;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Cantidad" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtCantidad" promptText="0" prefWidth="80" prefHeight="34"
                       style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Costo unitario (RD$)"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtCosto" promptText="0.00" prefWidth="120" prefHeight="34"
                       style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <Button text="+ Agregar" onAction="#onAgregarProducto"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 8 14; -fx-cursor: hand;"/>
    </HBox>

    <!-- Tabla de detalle -->
    <TableView fx:id="tablaDetalle" prefHeight="180"
               style="-fx-border-color: #DBEAFE; -fx-border-radius: 6; -fx-font-size: 12;">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto"    prefWidth="210"/>
            <TableColumn fx:id="colCantidad" text="Cantidad"    prefWidth="80"/>
            <TableColumn fx:id="colCosto"    text="Costo unit." prefWidth="120"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal"    prefWidth="120"/>
            <TableColumn fx:id="colQuitar"   text=""            prefWidth="80"/>
        </columns>
    </TableView>

    <!-- Total -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Label text="Total:"
               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1E40AF;"/>
        <Label fx:id="lblTotal" text="RD$0.00"
               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
    </HBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #DC2626; -fx-font-size: 12;"/>

    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Registrar compra" onAction="#onGuardar"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-background-radius: 6;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: transparent; -fx-text-fill: #2563EB;
                       -fx-border-color: #2563EB; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 13;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>