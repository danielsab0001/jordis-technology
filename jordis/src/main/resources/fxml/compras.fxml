<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.CompraController"
      spacing="0" style="-fx-background-color: #F8FAFF;">

    <HBox style="-fx-background-color: white; -fx-padding: 16 24;
                 -fx-border-color: #DBEAFE; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="12">
        <Text text="Gestión de Compras"
              style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Solo pendientes" onAction="#onVerPendientes"
                style="-fx-background-color: #FEF3C7; -fx-text-fill: #B45309;
                       -fx-border-color: #FDE68A; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 7 12; -fx-cursor: hand;"/>
        <Button text="Ver todas" onAction="#onVerTodas"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 7 12; -fx-cursor: hand;"/>
        <Button text="+ Nueva compra" onAction="#onNuevaCompra"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 12; -fx-background-radius: 6;
                       -fx-padding: 7 14; -fx-cursor: hand;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 16 24;">
        <TableView fx:id="tablaCompras" VBox.vgrow="ALWAYS"
                   style="-fx-border-color: #DBEAFE; -fx-border-radius: 8;
                          -fx-font-size: 12;">
            <columns>
                <TableColumn fx:id="colId"          text="#"           prefWidth="50"/>
                <TableColumn fx:id="colFecha"        text="Fecha"       prefWidth="130"/>
                <TableColumn fx:id="colProveedor"    text="Proveedor"   prefWidth="140"/>
                <TableColumn fx:id="colProductos"    text="Productos"   prefWidth="200"/>
                <TableColumn fx:id="colTotal"        text="Total"       prefWidth="100"/>
                <TableColumn fx:id="colEstado"       text="Estado"      prefWidth="90"/>
                <TableColumn fx:id="colAcciones"     text="Acciones"    prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="lblMensaje" text=""
           style="-fx-padding: 0 24 10 24; -fx-font-size: 12;"/>
</VBox>