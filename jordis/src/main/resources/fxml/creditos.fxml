<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.CreditoController"
      spacing="0" style="-fx-background-color: #F8FAFF;">

    <HBox style="-fx-background-color: white; -fx-padding: 16 24;
                 -fx-border-color: #DBEAFE; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="12">
        <Text text="Cuentas por Cobrar — Créditos"
              style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Solo pendientes" onAction="#onVerPendientes"
                style="-fx-background-color: #FEF3C7; -fx-text-fill: #B45309;
                       -fx-border-color: #FDE68A; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 7 12; -fx-cursor: hand;"/>
        <Button text="Ver todos" onAction="#onVerTodos"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 7 12; -fx-cursor: hand;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 16 24;">
        <TableView fx:id="tablaCreditos" VBox.vgrow="ALWAYS"
                   style="-fx-border-color: #DBEAFE; -fx-border-radius: 8;
                          -fx-font-size: 12;">
            <columns>
                <TableColumn fx:id="colFactura"   text="Factura"      prefWidth="90"/>
                <TableColumn fx:id="colFecha"     text="Fecha"        prefWidth="120"/>
                <TableColumn fx:id="colCliente"   text="Cliente"      prefWidth="150"/>
                <TableColumn fx:id="colTotal"     text="Total"        prefWidth="95"/>
                <TableColumn fx:id="colPagado"    text="Pagado"       prefWidth="95"/>
                <TableColumn fx:id="colSaldo"     text="Saldo"        prefWidth="95"/>
                <TableColumn fx:id="colVencimiento" text="Vence"      prefWidth="100"/>
                <TableColumn fx:id="colEstado"    text="Estado"       prefWidth="90"/>
                <TableColumn fx:id="colAcciones"  text="Acciones"     prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="lblMensaje" text=""
           style="-fx-padding: 0 24 10 24; -fx-font-size: 12;"/>
</VBox>