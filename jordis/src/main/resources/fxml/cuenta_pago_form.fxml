<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.CuentaPagoFormController"
      spacing="14" style="-fx-background-color: white; -fx-padding: 24;">

    <Text text="Registrar Pago a Proveedor"
          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>

    <VBox spacing="4"
          style="-fx-background-color: #EFF6FF; -fx-padding: 10 14;
                 -fx-border-radius: 6; -fx-background-radius: 6;">
        <Label fx:id="lblResumen"
               style="-fx-font-size: 12; -fx-text-fill: #1E40AF;"/>
        <Label fx:id="lblSaldo"
               style="-fx-font-size: 14; -fx-font-weight: bold;
                      -fx-text-fill: #DC2626;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Monto a pagar (RD$)"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtMonto" promptText="0.00" prefHeight="36"
                   style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Método de pago"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <ComboBox fx:id="cmbMetodoPago" prefWidth="340" prefHeight="36"
                  style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                         -fx-border-radius: 6; -fx-background-radius: 6;"/>
    </VBox>

    <HBox fx:id="boxOrigenEfectivo" spacing="16"
          style="-fx-background-color: #FFFBEB; -fx-padding: 10 14;
                 -fx-border-radius: 6; -fx-background-radius: 6;
                 -fx-border-color: #FDE68A;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="¿De dónde salió el efectivo?"
                   style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #92400E;"/>
            <RadioButton fx:id="radioDeLaCaja" text="De la caja registradora"
                         style="-fx-font-size: 12; -fx-text-fill: #78350F;"/>
            <RadioButton fx:id="radioOtroOrigen" text="De otro origen (no afecta la caja)"
                         style="-fx-font-size: 12; -fx-text-fill: #78350F;"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label text="Fecha del pago *"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <DatePicker fx:id="dpFechaPago" prefWidth="340" prefHeight="36"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Referencia / Notas (opcional)"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtNotas"
                   promptText="Nro. de transferencia, cheque, etc."
                   prefHeight="34"
                   style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
    </VBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #DC2626; -fx-font-size: 12;"/>

    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Registrar pago" onAction="#onGuardar"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-background-radius: 6;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: transparent; -fx-text-fill: #2563EB;
                       -fx-border-color: #2563EB; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 13;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>