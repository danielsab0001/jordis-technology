                        <!-- Top clientes enriquecido -->
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);">
