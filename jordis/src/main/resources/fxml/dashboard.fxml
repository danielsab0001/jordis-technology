<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.DashboardController"
      spacing="0" style="-fx-background-color: #F1F5F9;">

    <!-- ── Barra superior ── -->
    <HBox style="-fx-background-color: white; -fx-padding: 12 24;
                 -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="1">
            <Label fx:id="lblTituloPeriodo" text="Resumen del día"
                   style="-fx-font-size: 15; -fx-font-weight: bold;
                          -fx-text-fill: #0F172A;"/>
            <Label fx:id="lblUltimaActualizacion" text=""
                   style="-fx-font-size: 10; -fx-text-fill: #94A3B8;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblFecha"
               style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>

        <!-- Selector de período con Buttons normales -->
        <HBox fx:id="selectorPeriodo" spacing="2" alignment="CENTER"
              style="-fx-background-color: #F8FAFC;
                     -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                     -fx-background-radius: 8; -fx-padding: 3;">
            <Button fx:id="btnHoy"    text="Hoy"
                    onAction="#onCambiarPeriodo"/>
            <Button fx:id="btnSemana" text="Semana"
                    onAction="#onCambiarPeriodo"/>
            <Button fx:id="btnMes"    text="Mes"
                    onAction="#onCambiarPeriodo"/>
            <Button fx:id="btnAnio"   text="Año"
                    onAction="#onCambiarPeriodo"/>
        </HBox>

        <Button text="↻" onAction="#onActualizar"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 14;
                       -fx-padding: 4 10; -fx-cursor: hand;"/>
    </HBox>

    <!-- ── Pestañas ── -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS"
             tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color: #F1F5F9; -fx-tab-min-height: 36;">

        <!-- ═══════════════ RESUMEN ═══════════════ -->
        <Tab text="  📊  Resumen  ">
            <ScrollPane fitToWidth="true"
                        style="-fx-background: #F1F5F9;
                               -fx-background-color: #F1F5F9;">
                <VBox spacing="14" style="-fx-padding: 18 22;">

                    <!-- KPIs principales -->
                    <HBox spacing="10">
                        <VBox fx:id="cardVentas" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);
                                     -fx-cursor: hand;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="💰"
                                       style="-fx-font-size: 20;
                                              -fx-background-color: #EFF6FF;
                                              -fx-background-radius: 8;
                                              -fx-padding: 5 7;"/>
                                <VBox spacing="1">
                                    <Label text="VENTAS"
                                           style="-fx-font-size: 9;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #94A3B8;"/>
                                    <Label fx:id="lblVentas" text="RD$0"
                                           style="-fx-font-size: 20;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #0F172A;"/>
                                    <Label fx:id="lblVarVentas" text=""
                                           style="-fx-font-size: 11;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox fx:id="cardTransacciones" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);
                                     -fx-cursor: hand;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="🛒"
                                       style="-fx-font-size: 20;
                                              -fx-background-color: #F0FDF4;
                                              -fx-background-radius: 8;
                                              -fx-padding: 5 7;"/>
                                <VBox spacing="1">
                                    <Label text="TRANSACCIONES"
                                           style="-fx-font-size: 9;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #94A3B8;"/>
                                    <Label fx:id="lblTransacciones" text="0"
                                           style="-fx-font-size: 20;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #0F172A;"/>
                                    <Label fx:id="lblVarTrans"
                                           text=""
                                           style="-fx-font-size: 11;"/>
                                    <Label fx:id="lblTicketPromedio" text=""
                                           style="-fx-font-size: 11;
                                                  -fx-text-fill: #64748B;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox fx:id="cardCreditos" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);
                                     -fx-cursor: hand;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="📋"
                                       style="-fx-font-size: 20;
                                              -fx-background-color: #FEF3C7;
                                              -fx-background-radius: 8;
                                              -fx-padding: 5 7;"/>
                                <VBox spacing="1">
                                    <Label text="POR COBRAR"
                                           style="-fx-font-size: 9;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #94A3B8;"/>
                                    <Label fx:id="lblCreditosPendientes"
                                           text="RD$0"
                                           style="-fx-font-size: 20;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #B45309;"/>
                                    <Label fx:id="lblCreditosDetalle" text=""
                                           style="-fx-font-size: 11;
                                                  -fx-text-fill: #64748B;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox fx:id="cardCuentasPagar" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);
                                     -fx-cursor: hand;">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="💳"
                                       style="-fx-font-size: 20;
                                              -fx-background-color: #FEF2F2;
                                              -fx-background-radius: 8;
                                              -fx-padding: 5 7;"/>
                                <VBox spacing="1">
                                    <Label text="POR PAGAR"
                                           style="-fx-font-size: 9;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #94A3B8;"/>
                                    <Label fx:id="lblCuentasPorPagar"
                                           text="RD$0"
                                           style="-fx-font-size: 20;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #DC2626;"/>
                                    <Label fx:id="lblCuentasDetalle" text=""
                                           style="-fx-font-size: 11;
                                                  -fx-text-fill: #64748B;"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Fila 2: Alertas + Accesos rápidos -->
                    <HBox spacing="10">
                        <!-- Alertas -->
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);">
                            <HBox style="-fx-padding: 12 16 8 16;"
                                  alignment="CENTER_LEFT">
                                <Label text="🔔  Alertas activas"
                                       style="-fx-font-size: 12;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #0F172A;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblNumAlertas" text=""
                                       style="-fx-background-color: #DC2626;
                                              -fx-text-fill: white;
                                              -fx-padding: 1 7;
                                              -fx-background-radius: 10;
                                              -fx-font-size: 10;
                                              -fx-font-weight: bold;"/>
                            </HBox>
                            <Separator/>
                            <VBox fx:id="panelAlertas" spacing="0"/>
                        </VBox>

                        <!-- Accesos rápidos + Actividad -->
                        <VBox spacing="10" prefWidth="260">
                            <!-- Accesos rápidos -->
                            <VBox style="-fx-background-color: white;
                                         -fx-border-radius: 10;
                                         -fx-background-radius: 10;
                                         -fx-padding: 12 14;
                                         -fx-effect: dropshadow(gaussian,
                                             rgba(0,0,0,0.05),6,0,0,2);">
                                <Label text=" Acceso rápido"
                                       style="-fx-font-size: 12;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #0F172A;
                                              -fx-padding: 0 0 8 0;"/>
                                <Button text="Nueva venta"
                                        onAction="#onAccesoVenta"
                                        contentDisplay="LEFT" graphicTextGap="10"
                                        prefWidth="232" prefHeight="36"
                                        style="-fx-background-color: #2563EB;
                                               -fx-text-fill: white;
                                               -fx-font-size: 12;
                                               -fx-alignment: CENTER_LEFT;
                                               -fx-padding: 0 0 0 14;
                                               -fx-background-radius: 7;
                                               -fx-cursor: hand;">
                                    <graphic><Label text="＋" style="-fx-text-fill: white; -fx-font-size: 14; -fx-min-width: 16;"/></graphic>
                                </Button>
                                <Region prefHeight="5"/>
                                <Button text="Nueva compra"
                                        onAction="#onAccesoCompra"
                                        contentDisplay="LEFT" graphicTextGap="10"
                                        prefWidth="232" prefHeight="32"
                                        style="-fx-background-color: #F8FAFC;
                                               -fx-text-fill: #374151;
                                               -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 7;
                                               -fx-background-radius: 7;
                                               -fx-font-size: 11;
                                               -fx-alignment: CENTER_LEFT;
                                               -fx-padding: 0 0 0 14;
                                               -fx-cursor: hand;">
                                    <graphic><Label text="＋" style="-fx-text-fill: #374151; -fx-font-size: 13; -fx-min-width: 16;"/></graphic>
                                </Button>
                                <Region prefHeight="3"/>
                                <Button text="Nuevo cliente"
                                        onAction="#onAccesoCliente"
                                        contentDisplay="LEFT" graphicTextGap="10"
                                        prefWidth="232" prefHeight="32"
                                        style="-fx-background-color: #F8FAFC;
                                               -fx-text-fill: #374151;
                                               -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 7;
                                               -fx-background-radius: 7;
                                               -fx-font-size: 11;
                                               -fx-alignment: CENTER_LEFT;
                                               -fx-padding: 0 0 0 14;
                                               -fx-cursor: hand;">
                                    <graphic><Label text="＋" style="-fx-text-fill: #374151; -fx-font-size: 13; -fx-min-width: 16;"/></graphic>
                                </Button>
                                <Region prefHeight="3"/>
                                <Button text="Inventario"
                                        onAction="#onAccesoInventario"
                                        contentDisplay="LEFT" graphicTextGap="10"
                                        prefWidth="232" prefHeight="32"
                                        style="-fx-background-color: #F8FAFC;
                                               -fx-text-fill: #374151;
                                               -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 7;
                                               -fx-background-radius: 7;
                                               -fx-font-size: 11;
                                               -fx-alignment: CENTER_LEFT;
                                               -fx-padding: 0 0 0 14;
                                               -fx-cursor: hand;">
                                    <graphic><Label text="📦" style="-fx-font-size: 13; -fx-min-width: 16;"/></graphic>
                                </Button>
                                <Region prefHeight="3"/>
                                <Button text="Centro de alertas"
                                        onAction="#onAccesoAlertas"
                                        contentDisplay="LEFT" graphicTextGap="10"
                                        prefWidth="232" prefHeight="32"
                                        style="-fx-background-color: #F8FAFC;
                                               -fx-text-fill: #374151;
                                               -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 7;
                                               -fx-background-radius: 7;
                                               -fx-font-size: 11;
                                               -fx-alignment: CENTER_LEFT;
                                               -fx-padding: 0 0 0 14;
                                               -fx-cursor: hand;">
                                    <graphic><Label text="🔔" style="-fx-font-size: 13; -fx-min-width: 16;"/></graphic>
                                </Button>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Fila 3: Actividad reciente -->
                    <VBox style="-fx-background-color: white;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-effect: dropshadow(gaussian,
                                     rgba(0,0,0,0.05),6,0,0,2);">
                        <HBox style="-fx-padding: 12 16 8 16;"
                              alignment="CENTER_LEFT">
                            <Label text="🕐  Actividad reciente"
                                   style="-fx-font-size: 12;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Ver todo →"
                                    onAction="#onVerActividad"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: #2563EB;
                                           -fx-font-size: 11;
                                           -fx-cursor: hand;"/>
                        </HBox>
                        <Separator/>
                        <VBox fx:id="panelActividad" spacing="0"/>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ═══════════════ VENTAS ═══════════════ -->
        <Tab text="  📈  Ventas  ">
            <ScrollPane fitToWidth="true"
                        style="-fx-background: #F1F5F9;
                               -fx-background-color: #F1F5F9;">
                <VBox spacing="14" style="-fx-padding: 18 22;">

                    <!-- Mini KPIs -->
                    <HBox spacing="8">
                        <VBox fx:id="mkVentas" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-padding: 10 14;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.04),4,0,0,1);">
                            <Label text="TOTAL VENDIDO"
                                   style="-fx-font-size: 9;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #94A3B8;"/>
                            <Label fx:id="mkLblVentas" text="RD$0"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #2563EB;"/>
                            <Label fx:id="mkVarVentas" text=""
                                   style="-fx-font-size: 10;"/>
                        </VBox>
                        <VBox fx:id="mkCantidad" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-padding: 10 14;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.04),4,0,0,1);">
                            <Label text="VENTAS"
                                   style="-fx-font-size: 9;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #94A3B8;"/>
                            <Label fx:id="mkLblCantidad" text="0"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <Label fx:id="mkVarCantidad" text=""
                                   style="-fx-font-size: 10;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-padding: 10 14;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.04),4,0,0,1);">
                            <Label text="TICKET PROMEDIO"
                                   style="-fx-font-size: 9;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #94A3B8;"/>
                            <Label fx:id="mkLblTicket" text="RD$0"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <Label text="por transacción"
                                   style="-fx-font-size: 10;
                                          -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-padding: 10 14;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.04),4,0,0,1);">
                            <Label text="PRODUCTOS VENDIDOS"
                                   style="-fx-font-size: 9;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #94A3B8;"/>
                            <Label fx:id="mkLblProductos" text="0"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <Label text="unidades vendidas"
                                   style="-fx-font-size: 10;
                                          -fx-text-fill: #94A3B8;"/>
                        </VBox>
                    </HBox>

                    <!-- Gráfica principal con selector de métrica -->
                    <VBox style="-fx-background-color: white;
                                 -fx-border-radius: 10;
                                 -fx-background-radius: 10;
                                 -fx-effect: dropshadow(gaussian,
                                     rgba(0,0,0,0.05),6,0,0,2);">
                        <HBox style="-fx-padding: 12 16 8 16;"
                              alignment="CENTER_LEFT" spacing="12">
                            <Label text="Evolución de ventas"
                                   style="-fx-font-size: 13;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <!-- Selector de métrica -->
                            <ComboBox fx:id="cmbMetrica"
                                      onAction="#onCambiarMetrica"
                                      prefHeight="30" prefWidth="180"
                                      style="-fx-font-size: 12;"/>
                            <Label fx:id="lblTotalGrafica"
                                   style="-fx-font-size: 12;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #2563EB;"/>
                        </HBox>
                        <Separator/>
                        <AreaChart fx:id="graficaVentas" prefHeight="240"
                                   animated="false" legendVisible="false"
                                   style="-fx-background-color: transparent;
                                          -fx-padding: 8;">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis fx:id="ejeY"/></yAxis>
                        </AreaChart>
                    </VBox>

                    <!-- Top productos + Métodos de pago -->
                    <HBox spacing="10">
                        <!-- Top productos enriquecido -->
                        <VBox HBox.hgrow="ALWAYS" maxWidth="460"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);">
                            <HBox style="-fx-padding: 12 16 8 16;"
                                  alignment="CENTER_LEFT">
                                <Label text="🏆  Productos más vendidos"
                                       style="-fx-font-size: 12;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #0F172A;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="cmbTopProductos"
                                          onAction="#onCambiarTopProductos"
                                          prefWidth="100" prefHeight="26"
                                          style="-fx-font-size: 11;"/>
                            </HBox>
                            <Separator/>
                            <VBox fx:id="panelTopProductos"
                                  spacing="0"
                                  style="-fx-padding: 4 0;"/>
                        </VBox>

                        <!-- Métodos de pago -->
                        <VBox prefWidth="330" maxHeight="Infinity"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);">
                            <HBox style="-fx-padding: 12 16 8 16;">
                                <Label text="💳  Métodos de pago"
                                       style="-fx-font-size: 12;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #0F172A;"/>
                            </HBox>
                            <Separator/>
                            <VBox fx:id="panelMetodosPago"
                                  spacing="0"
                                  style="-fx-padding: 10 16;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ═══════════════ INVENTARIO ═══════════════ -->
        <Tab text="  📦  Inventario  ">
            <ScrollPane fitToWidth="true"
                        style="-fx-background: #F1F5F9;
                               -fx-background-color: #F1F5F9;">
                <VBox spacing="14" style="-fx-padding: 18 22;">

                    <!-- KPIs inventario -->
                    <HBox spacing="10">
                        <VBox HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);">
                            <Label text="📦  TOTAL PRODUCTOS"
                                   style="-fx-font-size: 9;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #94A3B8;"/>
                            <Label fx:id="lblTotalProductos" text="0"
                                   style="-fx-font-size: 22;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #0F172A;"/>
                            <Label fx:id="lblValorInventario" text=""
                                   style="-fx-font-size: 11;
                                          -fx-text-fill: #2563EB;"/>
                        </VBox>
                        <VBox fx:id="cardStockBajo" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
                                         rgba(0,0,0,0.05),6,0,0,2);
                                     -fx-cursor: hand;">
                            <Label text="⚠  STOCK BAJO"
                                   style="-fx-font-size: 9;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #B45309;"/>
                            <Label fx:id="lblStockBajo" text="0"
                                   style="-fx-font-size: 22;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #B45309;"/>
                            <Label text="necesitan reposición"
                                   style="-fx-font-size: 11;
                                          -fx-text-fill: #94A3B8;"/>
                        </VBox>
                        <VBox fx:id="cardSinStock" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-border-radius: 10;
                                     -fx-background-radius: 10;
                                     -fx-padding: 14 16;
                                     -fx-effect: dropshadow(gaussian,
