<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.DevolucionController"
      spacing="0" style="-fx-background-color: #F8FAFF;">

    <HBox style="-fx-background-color: white; -fx-padding: 16 24;
                 -fx-border-color: #DBEAFE; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="12">
        <Text text="Devoluciones"
              style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox style="-fx-background-color: #EFF6FF; -fx-padding: 14 24;
                 -fx-border-color: #DBEAFE; -fx-border-width: 0 0 1 0;" spacing="8">
        <Text text="Registrar nueva devolución"
              style="-fx-font-size: 13; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtFacturaNueva"
                       promptText="Número de factura de la venta (ej: FAC-00123)..."
                       prefWidth="320" prefHeight="34"
                       style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
            <Button text="Buscar y registrar devolución" onAction="#onNuevaDevolucion"
                    style="-fx-background-color: #2563EB; -fx-text-fill: white;
                           -fx-font-size: 12; -fx-background-radius: 6;
                           -fx-padding: 8 16; -fx-cursor: hand;"/>
        </HBox>
        <Label fx:id="lblMensajeNueva" text=""/>
    </VBox>

    <HBox style="-fx-padding: 12 24;" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar"
                   promptText="Buscar por número de factura..."
                   prefWidth="260" prefHeight="34"
                   style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                      -fx-border-radius: 6; -fx-background-radius: 6;
                      -fx-padding: 4 10;"/>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 16 24;">
        <TableView fx:id="tablaDevoluciones" VBox.vgrow="ALWAYS"
                   style="-fx-border-color: #DBEAFE; -fx-border-radius: 8;
                          -fx-font-size: 12;">
            <columns>
                <TableColumn fx:id="colId"        text="ID"           prefWidth="60"/>
                <TableColumn fx:id="colFactura"   text="Factura"      prefWidth="100"/>
                <TableColumn fx:id="colFecha"     text="Fecha"        prefWidth="130"/>
                <TableColumn fx:id="colProductos" text="Producto(s)"  prefWidth="220"/>
                <TableColumn fx:id="colTipo"      text="Tipo"         prefWidth="140"/>
                <TableColumn fx:id="colMonto"     text="Monto"        prefWidth="100"/>
                <TableColumn fx:id="colUsuario"   text="Usuario"      prefWidth="120"/>
                <TableColumn fx:id="colEstado"    text="Estado"       prefWidth="90"/>
                <TableColumn fx:id="colMotivo"    text="Motivo"       prefWidth="360"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="lblMensaje" text=""
           style="-fx-padding: 0 24 10 24; -fx-font-size: 12;"/>
</VBox>