<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jordis.jordis.controller.MainController"
            stylesheets="@../css/sidebar.css">

    <!-- Barra superior -->
    <top>
        <HBox style="-fx-background-color: #2563EB; -fx-padding: 12 20;"
              alignment="CENTER_LEFT" spacing="16">
            <Text text="Jordis"
                  style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: white;"/>
            <Text text="Technology"
                  style="-fx-font-size: 11; -fx-fill: #BFDBFE; -fx-translate-y: 3;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblBienvenida"
                   style="-fx-text-fill: #BFDBFE; -fx-font-size: 13;"/>
            <Label fx:id="lblRol"
                   style="-fx-text-fill: white; -fx-font-size: 11;
                          -fx-background-color: rgba(255,255,255,0.2);
                          -fx-padding: 3 10; -fx-background-radius: 10;"/>
            <Button text="Cerrar sesión" onAction="#onCerrarSesion"
                    style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5;
                           -fx-border-color: #FCA5A5; -fx-border-radius: 4;
                           -fx-background-radius: 4; -fx-cursor: hand;
                           -fx-font-size: 12; -fx-padding: 4 12;"/>
        </HBox>
    </top>

    <!-- Menú lateral -->
    <left>
        <VBox styleClass="sidebar" style="-fx-padding: 8 0;"
              spacing="2" prefWidth="220">


            <!-- Separador -->
            <Separator styleClass="sidebar-separator"/>
            <Region prefHeight="4"/>

            <!-- Sección MÓDULOS -->
            <Label text="MÓDULOS" styleClass="sidebar-section-label"
                   style="-fx-padding: 8 20 4 20; -fx-letter-spacing: 1;"/>

            <Button fx:id="btnDashboard" text="Dashboard" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onDashboard">
                <graphic><Label text="📊" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnVentas" text="Ventas" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onVentas">
                <graphic><Label text="💰" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnDevoluciones" text="Devoluciones" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onDevoluciones">
                <graphic><Label text="↩" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnClientes" text="Clientes" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onClientes">
                <graphic><Label text="👥" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnProductos" text="Productos" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onProductos">
                <graphic><Label text="📦" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnInventario" text="Inventario" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onInventario">
                <graphic><Label text="🗃" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnCompras" text="Compras" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onCompras">
                <graphic><Label text="🛒" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnProveedores" text="Proveedores" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onProveedores">
                <graphic><Label text="🏭" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnCreditos" text="Cuentas x Cobrar" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onCreditos">
                <graphic><Label text="📋" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnCuentasPorPagar" text="Cuentas x Pagar" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onCuentasPorPagar">
                <graphic><Label text="💳" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnCierreCaja" text="Cierre de Caja" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onCierreCaja">
                <graphic><Label text="🧾" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>

            <!-- Separador -->
            <Region prefHeight="4"/>
            <Separator styleClass="sidebar-separator"/>
            <Region prefHeight="4"/>

            <!-- Sección ADMINISTRACIÓN -->
            <Label fx:id="lblSeccionAdmin" text="ADMINISTRACIÓN" styleClass="sidebar-section-label"
                   style="-fx-padding: 4 20 4 20;"/>

            <Button fx:id="btnReportes" text="Reportes" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onReportes">
                <graphic><Label text="📄" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnUsuarios" text="Usuarios" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onUsuarios">
                <graphic><Label text="👤" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnAuditoria" text="Auditoría" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onAuditoria">
                <graphic><Label text="🕵" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnCategorias" text="Categorías" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onCategorias">
                <graphic><Label text="🏷" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>
            <Button fx:id="btnConfiguracion" text="Configuración" styleClass="sidebar-button"
                    contentDisplay="LEFT" prefWidth="204" prefHeight="40" onAction="#onConfiguracion">
                <graphic><Label text="⚙" styleClass="sidebar-icon"/></graphic>
                <VBox.margin><Insets left="8" right="8"/></VBox.margin>
            </Button>

            <!-- Alertas con contador -->
            <StackPane prefWidth="220" prefHeight="40" mouseTransparent="false">
                <Button fx:id="btnAlertas" text="Alertas" styleClass="sidebar-button"
                        contentDisplay="LEFT" prefWidth="204" prefHeight="40"
                        onAction="#onAlertas" mouseTransparent="false">
                    <graphic><Label text="🔔" styleClass="sidebar-icon"/></graphic>
                    <StackPane.margin><Insets left="8" right="8"/></StackPane.margin>
                </Button>
                <Label fx:id="lblAlertaContador" text="0"
                       StackPane.alignment="CENTER_RIGHT"
                       style="-fx-background-color: #DC2626; -fx-text-fill: white;
                          -fx-padding: 1 7; -fx-background-radius: 10;
                          -fx-font-size: 10; -fx-font-weight: bold;
                          -fx-translate-x: -14;"
                       visible="false" mouseTransparent="true"/>
            </StackPane>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Pie de barra -->
            <Separator styleClass="sidebar-separator"/>
        </VBox>
    </left>

    <!-- Área de contenido central -->
    <center>
        <AnchorPane fx:id="contenidoCentral"
                    style="-fx-background-color: #F8FAFF;"/>
    </center>

    <!-- Barra inferior -->
    <bottom>
        <HBox style="-fx-background-color: #EFF6FF; -fx-padding: 6 16;
                     -fx-border-color: #DBEAFE; -fx-border-width: 1 0 0 0;"
              alignment="CENTER_LEFT" spacing="16">
            <Label fx:id="lblEstado" text="Sistema listo"
                   style="-fx-text-fill: #2563EB; -fx-font-size: 12;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text=""
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 11;"/>
        </HBox>
    </bottom>
</BorderPane>