<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.ProveedorFormController"
      spacing="14" style="-fx-background-color: white; -fx-padding: 24;">

    <Text fx:id="txtTitulo" text="Nuevo Proveedor"
          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>

    <VBox spacing="4">
        <Label text="Nombre *" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtNombre" promptText="Ej: Tech Distribuidores RD"
                   prefHeight="34"
                   style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Contacto" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtContacto" promptText="Nombre del contacto"
                       prefHeight="34"
                       style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Teléfono" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtTelefono" promptText="Ej: 809-555-0100"
                       prefHeight="34"
                       style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label text="Correo electrónico"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtCorreo" promptText="Ej: ventas@proveedor.com"
                   prefHeight="34"
                   style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Dirección" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtDireccion"
                   promptText="Ej: Av. 27 de Febrero, Santo Domingo"
                   prefHeight="34"
                   style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
    </VBox>

    <VBox spacing="4">
        <Label text="Descripción" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextArea fx:id="txtDescripcion"
                  promptText="Descripción del proveedor, productos que suministra, condiciones, etc."
                  prefHeight="80" wrapText="true"
                  style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                         -fx-border-radius: 6; -fx-background-radius: 6;
                         -fx-padding: 4 10;"/>
    </VBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #DC2626; -fx-font-size: 12;"/>

    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Guardar" onAction="#onGuardar"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-background-radius: 6;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: transparent; -fx-text-fill: #2563EB;
                       -fx-border-color: #2563EB; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 13;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>