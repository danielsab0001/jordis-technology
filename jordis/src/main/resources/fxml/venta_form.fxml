<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import org.controlsfx.control.SearchableComboBox?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jordis.jordis.controller.VentaFormController"
      spacing="10" style="-fx-background-color: white; -fx-padding: 20;">

    <Text text="Nueva Venta"
          style="-fx-font-size: 16; -fx-font-weight: bold; -fx-fill: #1E40AF;"/>

    <!-- Fila 1: cliente y método de pago -->
    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Cliente (opcional)"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <SearchableComboBox fx:id="cmbCliente" prefWidth="260" prefHeight="34"
                                    promptText="Sin cliente (ocasional)"/>
                <Button text="＋ Nuevo" onAction="#onNuevoCliente"
                        style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                   -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                   -fx-background-radius: 6; -fx-font-size: 11;
                   -fx-padding: 8 10; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
        <VBox spacing="4">
            <Label text="Método de pago"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <ComboBox fx:id="cmbMetodoPago" prefWidth="150" prefHeight="34"
                      style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                             -fx-border-radius: 6; -fx-background-radius: 6;"/>
        </VBox>
    </HBox>

    <!-- Venta a crédito -->
    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: #FEF2F2; -fx-padding: 8 12;
                 -fx-border-radius: 6; -fx-background-radius: 6;">
        <CheckBox fx:id="chkCredito" text="Venta a crédito (solo empresas)"
                  onAction="#onToggleCredito"
                  style="-fx-font-size: 12; -fx-font-weight: bold;
                         -fx-text-fill: #DC2626;"/>
        <Label text="Fecha límite de pago:"
               fx:id="lblFechaLimite" visible="false" managed="false"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <DatePicker fx:id="dpFechaLimite" visible="false" managed="false"
                    prefWidth="150" prefHeight="34"
                    style="-fx-font-size: 12;"/>
    </HBox>

    <!-- Saldo a favor del cliente (de devoluciones anteriores) -->
    <HBox fx:id="boxSaldoAFavor" spacing="14" alignment="CENTER_LEFT"
          visible="false" managed="false"
          style="-fx-background-color: #ECFDF5; -fx-padding: 8 12;
                 -fx-border-radius: 6; -fx-background-radius: 6;">
        <CheckBox fx:id="chkAplicarSaldoAFavor" text="Aplicar saldo a favor del cliente"
                  onAction="#onToggleSaldoAFavor"
                  style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
        <Label fx:id="lblSaldoDisponible" text="Disponible: RD$0.00"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <Label text="Monto a aplicar:"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtMontoSaldoAFavor" prefWidth="110" prefHeight="30"
                   text="0.00" disable="true"
                   style="-fx-font-size: 12; -fx-border-color: #A7F3D0;
                          -fx-border-radius: 6; -fx-background-radius: 6;"/>
    </HBox>

    <!-- Crédito fiscal / NCF -->
    <HBox spacing="14" alignment="CENTER_LEFT"
          style="-fx-background-color: #F0FDF4; -fx-padding: 8 12;
             -fx-border-radius: 6; -fx-background-radius: 6;">
        <CheckBox fx:id="chkCreditoFiscal"
                  text="Generar comprobante fiscal (NCF)"
                  onAction="#onToggleCreditoFiscal"
                  style="-fx-font-size: 12; -fx-font-weight: bold;
                     -fx-text-fill: #15803D;"/>
        <Label text="Tipo NCF:" fx:id="lblTipoNcf"
               visible="false" managed="false"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <ComboBox fx:id="cmbTipoNcf" visible="false" managed="false"
                  prefWidth="220" prefHeight="32"
                  style="-fx-font-size: 12; -fx-border-color: #BBF7D0;
                     -fx-border-radius: 6; -fx-background-radius: 6;"/>
        <Label text="ITBIS %:" fx:id="lblItbis"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <ComboBox fx:id="cmbItbis"
                  prefWidth="100" prefHeight="32"
                  style="-fx-font-size: 12; -fx-border-color: #BBF7D0;
                     -fx-border-radius: 6; -fx-background-radius: 6;"/>
    </HBox>

    <!-- Agregar producto -->
    <HBox spacing="10" alignment="BOTTOM_LEFT">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Buscar producto"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <SearchableComboBox fx:id="cmbProducto" prefWidth="260" prefHeight="34"
                      style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                             -fx-border-radius: 6; -fx-background-radius: 6;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Cantidad"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtCantidad" promptText="1" prefWidth="70"
                       prefHeight="34"
                       style="-fx-font-size: 13; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Descuento producto (RD$)"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtDescuentoProducto" promptText="0.00" prefWidth="110"
                       prefHeight="34"
                       style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Garantía"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <ComboBox fx:id="cmbGarantiaTipo" prefWidth="190" prefHeight="34"
                      style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                             -fx-border-radius: 6; -fx-background-radius: 6;"/>
            <TextField fx:id="txtGarantiaOtra" promptText="Describe la garantía..."
                       visible="false" managed="false"
                       prefWidth="190" prefHeight="34"
                       style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 10;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Meses"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtGarantiaMeses" promptText="0" prefWidth="55"
                       prefHeight="34"
                       style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 8;"/>
        </VBox>
        <Button text="+ Agregar" onAction="#onAgregarProducto"
                style="-fx-background-color: #EFF6FF; -fx-text-fill: #2563EB;
                       -fx-border-color: #BFDBFE; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 12;
                       -fx-padding: 8 14; -fx-cursor: hand;"/>
    </HBox>

    <!-- Tabla de productos -->
    <TableView fx:id="tablaDetalle" VBox.vgrow="ALWAYS" minHeight="200"
               style="-fx-border-color: #DBEAFE; -fx-border-radius: 6; -fx-font-size: 12;">
        <columns>
            <TableColumn fx:id="colProducto"  text="Producto"    prefWidth="190"/>
            <TableColumn fx:id="colCantidad"  text="Cant."       prefWidth="55"/>
            <TableColumn fx:id="colPrecio"    text="Precio"      prefWidth="100"/>
            <TableColumn fx:id="colDescuentoProducto" text="Desc. producto" prefWidth="110"/>
            <TableColumn fx:id="colGarantia"  text="Garantía"    prefWidth="230"/>
            <TableColumn fx:id="colSubtotal"  text="Subtotal"    prefWidth="100"/>
            <TableColumn fx:id="colQuitar"    text=""            prefWidth="60"/>
        </columns>
    </TableView>

    <!-- Notas de la venta -->
    <VBox spacing="4">
        <Label text="Notas / Observaciones (opcional)"
               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
        <TextField fx:id="txtNotas"
                   promptText="Acuerdos especiales, imprevistos, condiciones..."
                   prefHeight="34"
                   style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                          -fx-border-radius: 6; -fx-background-radius: 6;
                          -fx-padding: 4 10;"/>
    </VBox>

    <!-- Descuento y totales -->
    <HBox spacing="16" alignment="CENTER_RIGHT">
        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="Descuento"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <ComboBox fx:id="cmbDescuento" prefWidth="130" prefHeight="32"
                      style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                             -fx-border-radius: 6; -fx-background-radius: 6;"/>
        </VBox>
        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="Manual"
                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
            <TextField fx:id="txtDescuentoManual" promptText="0.00"
                       prefWidth="75" prefHeight="32"
                       style="-fx-font-size: 12; -fx-border-color: #BFDBFE;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 4 8;"/>
        </VBox>
        <VBox spacing="3" alignment="CENTER_RIGHT"
              style="-fx-background-color: #F8FAFF; -fx-padding: 8 14;
                     -fx-border-color: #DBEAFE; -fx-border-radius: 8;
                     -fx-background-radius: 8;">
            <HBox spacing="24" alignment="CENTER_RIGHT">
                <Label text="Subtotal:"
                       style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                <Label fx:id="lblSubtotal" text="RD$0.00"
                       style="-fx-font-size: 13; -fx-text-fill: #0F172A;
                              -fx-min-width: 100; -fx-alignment: CENTER_RIGHT;"/>
            </HBox>
            <HBox spacing="24" alignment="CENTER_RIGHT">
                <Label fx:id="lblDescuentoProductosLabel" text="Descuento en productos:"
                       visible="false" managed="false"
                       style="-fx-font-size: 12; -fx-text-fill: #DC2626;"/>
                <Label fx:id="lblDescuentoProductosMonto" text="—"
                       visible="false" managed="false"
                       style="-fx-font-size: 12; -fx-text-fill: #DC2626;
                              -fx-min-width: 100; -fx-alignment: CENTER_RIGHT;"/>
            </HBox>
            <HBox spacing="24" alignment="CENTER_RIGHT">
                <Label fx:id="lblDescuentoLabel" text="Descuento (0%):"
                       style="-fx-font-size: 12; -fx-text-fill: #DC2626;"/>
                <Label fx:id="lblDescuentoMonto" text="—"
                       style="-fx-font-size: 12; -fx-text-fill: #DC2626;
                              -fx-min-width: 100; -fx-alignment: CENTER_RIGHT;"/>
            </HBox>
            <Separator/>
            <HBox spacing="24" alignment="CENTER_RIGHT">
                <Label fx:id="lblItbisLabel" text="ITBIS (18%):"
                       visible="false" managed="false"
                       style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                <Label fx:id="lblItbisMonto" text="RD$0.00"
                       visible="false" managed="false"
                       style="-fx-font-size: 13; -fx-text-fill: #64748B;
                  -fx-min-width: 100; -fx-alignment: CENTER_RIGHT;"/>
            </HBox>
            <Separator/>
            <HBox spacing="24" alignment="CENTER_RIGHT">
                <Label text="TOTAL:"
                       style="-fx-font-size: 13; -fx-font-weight: bold;
                              -fx-text-fill: #1E40AF;"/>
                <Label fx:id="lblTotal" text="RD$0.00"
                       style="-fx-font-size: 20; -fx-font-weight: bold;
                              -fx-text-fill: #2563EB; -fx-min-width: 100;
                              -fx-alignment: CENTER_RIGHT;"/>
            </HBox>
        </VBox>
    </HBox>

    <Label fx:id="lblError" text="" wrapText="true"
           style="-fx-text-fill: #DC2626; -fx-font-size: 12;"/>

    <HBox spacing="10">
        <Button fx:id="btnGuardar" text="Registrar venta" onAction="#onGuardar"
                style="-fx-background-color: #2563EB; -fx-text-fill: white;
                       -fx-font-size: 13; -fx-background-radius: 6;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: transparent; -fx-text-fill: #2563EB;
                       -fx-border-color: #2563EB; -fx-border-radius: 6;
                       -fx-background-radius: 6; -fx-font-size: 13;
                       -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>
</VBox>